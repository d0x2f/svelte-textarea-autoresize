{
  "name": "svelte-textarea-autoresize",
  "version": "2.1.1",
  "description": "An autoresizing textarea for svelte",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0x2f/svelte-textarea-autoresize.git"
  },
  "scripts": {
    "build": "rollup -c",
    "autobuild": "rollup -c -w",
    "webserver": "sirv public --single --dev",
    "dev": "run-p webserver autobuild",
    "lint": "eslint .",
    "format:svelte": "prettier --check **/*.svelte",
    "format:js": "prettier --check **/*.js",
    "format": "run-p format:svelte format:js",
    "test": "npx nightwatch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "chromedriver": "^147.0.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-svelte": "^3.17.0",
    "husky": "^9.1.7",
    "nightwatch": "^3.15.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^3.5.1",
    "rollup": "^4.60.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-svelte": "^7.2.3",
    "sirv-cli": "^3.0.1",
    "svelte": "^5.55.3"
  },
  "keywords": [
    "svelte",
    "component",
    "textarea",
    "autoresize"
  ],
  "files": [
    "src/index.js",
    "src/AutoresizingTextAreaComponent"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "exports": {
    ".": "./src/index.js"
  }
}
